rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSeller(productId) {
      return signedIn() &&
        get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid;
    }

    // Each user's private cart
    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.sellerId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() &&
          (resource.data.userId == request.auth.uid || isSeller(productId));
      }

      match /offers/{offerId} {
        allow read: if signedIn() &&
          (resource.data.buyerId == request.auth.uid || isSeller(productId));
        allow create: if signedIn() &&
          request.resource.data.buyerId == request.auth.uid &&
          request.resource.data.status == "pending";
        allow update: if isSeller(productId);
      }
    }

    // Real-time chat: one chat per buyer per product, id = productId_buyerId
    match /chats/{chatId} {
      allow get: if signedIn() &&
        (resource == null || request.auth.uid in resource.data.participants);

      allow list: if signedIn() &&
        request.auth.uid in resource.data.participants;

      allow create: if signedIn() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.sellerId != request.auth.uid &&
        request.resource.data.participants == [request.resource.data.sellerId, request.auth.uid] &&
        chatId == request.resource.data.productId + "_" + request.auth.uid &&
        request.resource.data.sellerId ==
          get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerId;

      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.productId == resource.data.productId;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}